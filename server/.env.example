# Copy to server/.env (never commit the real one). Render/Railway: set these in the dashboard.
PORT=3001
# Required on public deployments: passcode for /admin control. Leave empty for local dev.
ADMIN_CODE=
# Optional: comma-separated allowed origins for browser + socket access. Empty = same setup as local.
# CLIENT_URL=https://your-game.onrender.com
CLIENT_URL=
